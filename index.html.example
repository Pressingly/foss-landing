<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Launchpad</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --navy:         #0f1623;
    --accent:       #3b7ff5;
    --accent-glow:  rgba(59,127,245,0.12);
    --hero-border:  rgba(255,255,255,0.07);
    --hero-muted:   #6b7e9f;
    --hero-dim:     #3a4f6e;

    --bg:           #f1f3f7;
    --surface:      #ffffff;
    --border-light: #e4e8ef;
    --text-head:    #0f1623;
    --text-body:    #4b5563;
    --text-meta:    #9ca3af;
  }

  body {
    margin: 0;
    background: var(--bg);
    font-family: 'DM Sans', sans-serif;
    color: var(--text-body);
  }

  /* ══════════════════════════════
     HERO
  ══════════════════════════════ */
  .hero {
    width: 100%;
    background: var(--navy);
    padding: 64px 48px 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: 600px; height: 300px;
    background: radial-gradient(ellipse at 50% 0%, var(--accent-glow) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .org-logo {
    max-width: 280px; height: auto;
    border-radius: 0;
    overflow: hidden;
    margin-bottom: 20px;
  }
  .org-logo img { width: 100%; height: auto; object-fit: contain; display: block; }

  .org-row { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }

  .org-name {
    font-family: 'Syne', sans-serif;
    font-size: 13px; font-weight: 700;
    color: var(--hero-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .org-divider { width: 1px; height: 12px; background: var(--hero-dim); }

  .platform-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800; font-size: 38px;
    color: #f0f4ff;
    letter-spacing: -1px; line-height: 1.1;
    margin: 16px 0 10px;
  }
  .platform-title em { font-style: normal; color: var(--accent); }

  .platform-sub {
    font-size: 15px; color: var(--hero-muted);
    margin-bottom: 32px; line-height: 1.5;
  }

  .app-pills {
    display: flex; gap: 8px;
    flex-wrap: wrap; justify-content: center;
    margin-bottom: 32px;
  }

  .app-pill {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--hero-border);
    border-radius: 100px; padding: 5px 12px;
    font-size: 12px; color: var(--hero-muted); font-weight: 500;
  }

  .app-pill-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent); opacity: 0.6;
  }

  .auth-badge {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--hero-dim);
    font-size: 12px; font-weight: 500;
    border-top: 1px solid var(--hero-border);
    padding-top: 24px; margin-top: 8px;
  }
  .auth-badge .dot {
    width: 3px; height: 3px; border-radius: 50%;
    background: var(--hero-dim);
  }

  /* ══════════════════════════════
     PAGE BODY
  ══════════════════════════════ */
  .page-body {
    max-width: 1000px;
    margin: 0 auto;
    padding: 36px 24px 64px;
  }

  /* ── Welcome card ── */
  .welcome-card {
    background: var(--surface);
    border-radius: 14px;
    border: 1px solid var(--border-light);
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 40px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  }

  .welcome-card-top { display: flex; align-items: center; gap: 10px; }

  .welcome-icon {
    width: 26px; height: 26px;
    border-radius: 7px;
    background: #eef3ff;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .welcome-icon svg { width: 13px; height: 13px; }

  .welcome-title {
    font-family: 'Syne', sans-serif;
    font-size: 13.5px; font-weight: 700;
    color: var(--text-head);
  }

  .welcome-text { font-size: 13px; color: var(--text-body); line-height: 1.65; }

  /* ── Section heading ── */
  .section-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .section-heading-label {
    font-family: 'Syne', sans-serif;
    font-size: 13px; font-weight: 700;
    color: var(--text-head);
    letter-spacing: 0.01em;
  }

  .section-heading-line {
    flex: 1;
    height: 1px;
    background: var(--border-light);
  }

  .section-heading-count {
    font-size: 11px; font-weight: 600;
    color: var(--text-meta);
    background: #f1f3f7;
    border: 1px solid var(--border-light);
    border-radius: 100px;
    padding: 2px 9px;
  }

  /* ── App cards grid ── */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
    margin-bottom: 48px;
  }

  .app-card {
    background: var(--surface);
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 22px 20px 18px;
    display: flex; flex-direction: column;
    text-decoration: none;
    position: relative; overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
  }

  .app-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--card-stripe, #e4e8ef);
    border-radius: 16px 16px 0 0;
    transition: opacity 0.2s;
  }

  .app-card:hover {
    border-color: #d0d8e8;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.09);
  }

  .card-outline   { --card-stripe: #63b3ed; }
  .card-plane     { --card-stripe: #68d391; }
  .card-penpot    { --card-stripe: #f6ad55; }
  .card-surfsense { --card-stripe: #b794f6; }
  .card-twenty    { --card-stripe: #4f46e5; }

  .card-icon-wrap {
    width: 38px; height: 38px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    margin-bottom: 16px;
    flex-shrink: 0;
  }

  .card-outline   .card-icon-wrap { background: rgba(99,179,237,0.1);  }
  .card-plane     .card-icon-wrap { background: rgba(104,211,145,0.1); }
  .card-penpot    .card-icon-wrap { background: rgba(246,173,85,0.1);  }
  .card-surfsense .card-icon-wrap { background: rgba(183,148,246,0.1); }
  .card-twenty    .card-icon-wrap { background: rgba(79,70,229,0.1);   }

  .card-category {
    font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    margin-bottom: 5px;
  }
  .card-outline   .card-category { color: #3a9fd5; }
  .card-plane     .card-category { color: #38a169; }
  .card-penpot    .card-category { color: #c97c2a; }
  .card-surfsense .card-category { color: #805ad5; }
  .card-twenty    .card-category { color: #4338ca; }

  .card-name {
    font-family: 'Syne', sans-serif;
    font-size: 16px; font-weight: 700;
    color: var(--text-head);
    margin-bottom: 8px;
  }

  .card-desc {
    font-size: 12.5px; color: var(--text-body);
    line-height: 1.6; flex: 1;
    margin-bottom: 18px;
  }

  .card-link {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 12.5px; font-weight: 600;
    color: var(--text-meta);
    transition: color 0.15s;
  }
  .card-link svg { width: 13px; height: 13px; transition: transform 0.2s; }
  .app-card:hover .card-link { color: var(--accent); }
  .app-card:hover .card-link svg { transform: translateX(3px); }

  /* ══════════════════════════════
     INFRA SECTION
  ══════════════════════════════ */
  .infra-disclosure {
    background: var(--surface);
    border: 1px solid var(--border-light);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    margin-bottom: 48px;
  }

  .infra-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .infra-summary::-webkit-details-marker { display: none; }

  .infra-summary-icon {
    width: 26px; height: 26px;
    border-radius: 7px;
    background: #f1f3f7;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    font-size: 13px;
  }

  .infra-summary-label {
    font-family: 'Syne', sans-serif;
    font-size: 13px; font-weight: 700;
    color: var(--text-head);
    flex: 1;
  }

  .infra-chevron {
    width: 16px; height: 16px;
    color: var(--text-meta);
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  details[open] .infra-chevron { transform: rotate(180deg); }

  .infra-body {
    border-top: 1px solid var(--border-light);
    padding: 8px 0;
  }

  .infra-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 20px;
    text-decoration: none;
    transition: background 0.15s;
    border-bottom: 1px solid var(--border-light);
  }

  .infra-item:last-child { border-bottom: none; }
  .infra-item:hover { background: #f7f9fc; }

  .infra-item-icon {
    width: 32px; height: 32px;
    border-radius: 8px;
    background: #f1f3f7;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; flex-shrink: 0;
    margin-top: 1px;
  }

  .infra-item-text { display: flex; flex-direction: column; gap: 2px; }

  .infra-item-name {
    font-family: 'Syne', sans-serif;
    font-size: 13px; font-weight: 700;
    color: var(--text-head);
  }

  .infra-item-desc {
    font-size: 12px; color: var(--text-body); line-height: 1.5;
  }

  .infra-item-url {
    margin-top: 4px;
    font-size: 11px; color: var(--accent);
    font-weight: 500;
  }

  /* ══════════════════════════════
     QUICK START
  ══════════════════════════════ */
  .quickstart-card {
    background: var(--surface);
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 20px 24px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    margin-bottom: 48px;
  }

  .quickstart-card .section-heading { margin-bottom: 14px; }

  .quickstart-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .quickstart-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    color: var(--text-body);
    line-height: 1.55;
  }

  .qs-bullet {
    width: 18px; height: 18px;
    border-radius: 50%;
    background: #eef3ff;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .qs-bullet svg { width: 10px; height: 10px; color: var(--accent); }

  .qs-bold { font-weight: 600; color: var(--text-head); }

  /* ══════════════════════════════
     FOOTER
  ══════════════════════════════ */
  .page-footer {
    border-top: 1px solid var(--border-light);
    padding: 20px 24px;
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer-left { display: flex; align-items: center; gap: 6px; }

  .footer-tag {
    display: inline-flex; align-items: center; gap: 5px;
    background: var(--surface);
    border: 1px solid var(--border-light);
    border-radius: 100px;
    padding: 3px 10px;
    font-size: 11px; font-weight: 600;
    color: var(--text-meta);
  }

  .footer-tag .dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: #68d391;
  }

  .footer-meta {
    font-size: 11.5px;
    color: var(--text-meta);
  }

  .footer-meta span { color: #bcc5d4; margin: 0 5px; }

  /* ══════════════════════════════
     ANIMATIONS
  ══════════════════════════════ */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-inner > * { animation: fadeUp 0.5s ease both; }
  .hero-inner > *:nth-child(1) { animation-delay: 0.05s; }
  .hero-inner > *:nth-child(2) { animation-delay: 0.10s; }
  .hero-inner > *:nth-child(3) { animation-delay: 0.15s; }
  .hero-inner > *:nth-child(4) { animation-delay: 0.20s; }
  .hero-inner > *:nth-child(5) { animation-delay: 0.25s; }
  .hero-inner > *:nth-child(6) { animation-delay: 0.30s; }

  .welcome-card          { animation: fadeUp 0.5s ease 0.35s both; }
  .app-card:nth-child(1) { animation: fadeUp 0.5s ease 0.40s both; }
  .app-card:nth-child(2) { animation: fadeUp 0.5s ease 0.45s both; }
  .app-card:nth-child(3) { animation: fadeUp 0.5s ease 0.50s both; }
  .app-card:nth-child(4) { animation: fadeUp 0.5s ease 0.55s both; }

  /* ══════════════════════════════
     AUTH BUTTON (hero top-right) + TOAST
  ══════════════════════════════ */
  .auth-btn {
    position: absolute;
    top: 20px;
    right: 24px;
    background: rgba(255,255,255,0.08);
    color: #fff;
    border: 1px solid var(--hero-border);
    padding: 9px 16px;
    border-radius: 6px;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    min-width: 130px;
    z-index: 2;
  }
  .auth-btn:hover:not(:disabled) { transform: translateY(-1px); }
  .auth-btn:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }
  .auth-btn-login {
    background: var(--accent);
    border-color: transparent;
  }
  .auth-btn-login:hover:not(:disabled) { background: #2f6fe0; }
  .auth-btn-logout {
    background: #dc2626;
    border-color: transparent;
  }
  .auth-btn-logout:hover:not(:disabled) { background: #b91c1c; }
  @media (max-width: 640px) {
    .auth-btn { position: static; margin-top: 20px; display: inline-block; }
  }

  .toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translate(-50%, 20px);
    background: var(--navy);
    color: #fff;
    border: 1px solid var(--hero-border);
    border-left: 4px solid var(--accent);
    padding: 14px 22px;
    border-radius: 6px;
    font-family: inherit;
    font-weight: 500;
    font-size: 14px;
    box-shadow: 0 10px 30px rgba(15,22,35,0.25);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
    z-index: 1000;
  }
  .toast-visible { opacity: 1; transform: translate(-50%, 0); }
</style>
</head>
<body>

<!-- ─── HERO ─── -->
<header class="hero">
  <button type="button" id="auth-btn" class="auth-btn" disabled>Checking session...</button>
  <div class="hero-inner">

    <div class="org-logo">
      <img src="data:image/png;base64," alt="Moneta Network" />
    </div>

    <div class="org-row">
      <span class="org-name">Moneta Network</span>
      <span class="org-divider"></span>
      <span class="org-name" style="opacity:0.5;">Internal Platform</span>
    </div>

    <h1 class="platform-title"><em>Launchpad</em></h1>
    <p class="platform-sub">Your integrated suite of open-source tools</p>

    <div class="app-pills">
      <span class="app-pill"><span class="app-pill-dot"></span>Outline</span>
      <span class="app-pill"><span class="app-pill-dot"></span>Plane</span>
      <span class="app-pill"><span class="app-pill-dot"></span>Penpot</span>
      <span class="app-pill"><span class="app-pill-dot"></span>SurfSense</span>
      <span class="app-pill"><span class="app-pill-dot"></span>Twenty</span>
    </div>

    <div class="auth-badge">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#3a4f6e" stroke-width="2.5">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>SSO enabled</span>
    </div>

  </div>
</header>

<!-- ─── PAGE BODY ─── -->
<div class="page-body">

  <!-- Welcome -->
  <div class="welcome-card">
    <div class="welcome-card-top">
      <div class="welcome-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#3b7ff5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
      </div>
      <div class="welcome-title">You're all set — just sign in with your SSO credentials</div>
    </div>
    <p class="welcome-text">
      All tools below are connected via single sign-on, so there's no separate login or password to manage. If you run into access issues, reach out to your team admin.
    </p>
  </div>

  <!-- Core Applications -->
  <div class="section-heading">
    <span class="section-heading-label">Core Applications</span>
    <span class="section-heading-line"></span>
    <span class="section-heading-count">4 apps</span>
  </div>

  <div class="cards-grid">

    <a class="app-card card-outline" href="{{PROTOCOL}}://docs.{{DOMAIN}}">
      <div class="card-icon-wrap">📝</div>
      <div class="card-category">Knowledge Wiki</div>
      <div class="card-name">Outline</div>
      <div class="card-desc">Documentation and knowledge management for your team</div>
      <div class="card-link">
        Open
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </div>
    </a>

    <a class="app-card card-plane" href="{{PROTOCOL}}://pm.{{DOMAIN}}">
      <div class="card-icon-wrap">📋</div>
      <div class="card-category">Project Management</div>
      <div class="card-name">Plane</div>
      <div class="card-desc">Issue tracking and project planning for agile teams</div>
      <div class="card-link">
        Open
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </div>
    </a>

    <a class="app-card card-penpot" href="{{PROTOCOL}}://design.{{DOMAIN}}">
      <div class="card-icon-wrap">🎨</div>
      <div class="card-category">Design Tool</div>
      <div class="card-name">Penpot</div>
      <div class="card-desc">Collaborative design and prototyping platform</div>
      <div class="card-link">
        Open
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </div>
    </a>

    <a class="app-card card-surfsense" href="{{PROTOCOL}}://research.{{DOMAIN}}">
      <div class="card-icon-wrap">🔍</div>
      <div class="card-category">AI Research</div>
      <div class="card-name">SurfSense</div>
      <div class="card-desc">Connect your knowledge sources to powerful AI — find answers across all your docs</div>
      <div class="card-link">
        Open
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </div>
    </a>

    <a class="app-card card-twenty" href="{{PROTOCOL}}://twenty.{{DOMAIN}}">
      <div class="card-icon-wrap">👥</div>
      <div class="card-category">CRM</div>
      <div class="card-name">Twenty</div>
      <div class="card-desc">Track customers, deals, and pipelines — your contacts and revenue in one view</div>
      <div class="card-link">
        Open
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </div>
    </a>

  </div>

  <!-- Infrastructure & Tools -->
  <div class="section-heading">
    <span class="section-heading-label">Infrastructure &amp; Tools</span>
    <span class="section-heading-line"></span>
    <span class="section-heading-count">Admin</span>
  </div>

  <details class="infra-disclosure" style="margin-bottom:48px;">
    <summary class="infra-summary">
      <div class="infra-summary-icon">🛠</div>
      <span class="infra-summary-label">Administration &amp; Storage Tools</span>
      <svg class="infra-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </summary>
    <div class="infra-body">

      <a class="infra-item" href="{{PROTOCOL}}://traefik.{{DOMAIN}}">
        <div class="infra-item-icon">🔀</div>
        <div class="infra-item-text">
          <span class="infra-item-name">Traefik Dashboard</span>
          <span class="infra-item-desc">Reverse proxy and HTTP routing management</span>
          <span class="infra-item-url">traefik.{{DOMAIN}}</span>
        </div>
      </a>

      <a class="infra-item" href="{{PROTOCOL}}://s3.{{DOMAIN}}">
        <div class="infra-item-icon">💾</div>
        <div class="infra-item-text">
          <span class="infra-item-name">SeaweedFS Filer UI</span>
          <span class="infra-item-desc">File browser and object storage management interface</span>
          <span class="infra-item-url">s3.{{DOMAIN}}</span>
        </div>
      </a>

      <a class="infra-item" href="{{PROTOCOL}}://s3api.{{DOMAIN}}">
        <div class="infra-item-icon">🔌</div>
        <div class="infra-item-text">
          <span class="infra-item-name">SeaweedFS S3 API</span>
          <span class="infra-item-desc">S3-compatible object storage API endpoint</span>
          <span class="infra-item-url">s3api.{{DOMAIN}}</span>
        </div>
      </a>

    </div>
  </details>

  <!-- Quick Start -->
  <div class="section-heading">
    <span class="section-heading-label">Quick Start</span>
    <span class="section-heading-line"></span>
  </div>

  <div class="quickstart-card">
    <ul class="quickstart-list">
      <li>
        <div class="qs-bullet">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        All applications authenticate via <span class="qs-bold">single sign-on (SSO)</span>
      </li>
      <li>
        <div class="qs-bullet">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        First user to log in becomes the <span class="qs-bold">instance administrator</span>
      </li>
      <li>
        <div class="qs-bullet">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        Additional users are managed through each application's <span class="qs-bold">admin panel</span>
      </li>
      <li>
        <div class="qs-bullet">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        Object storage (SeaweedFS) is configured automatically during <span class="qs-bold">platform setup</span>
      </li>
      <li>
        <div class="qs-bullet">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        For AI research, open <span class="qs-bold">SurfSense</span> and connect your knowledge sources
      </li>
    </ul>
  </div>

</div>

<!-- ─── FOOTER ─── -->
<footer class="page-footer">
  <div class="footer-left">
    <div class="footer-tag">
      <span class="dot"></span>
      Powered by open-source software
    </div>
    <div class="footer-tag" style="margin-left:6px;">Phase 1 (P0)</div>
  </div>
  <div class="footer-meta">
    v0.7 <span>·</span> Last updated 2026-02-23
  </div>
</footer>

<script>
(function () {
    // Values substituted at `./platform.sh --setup` time.
    window.FOSS_LOGOUT = {
        portal: "{{PROTOCOL}}://{{DOMAIN}}",
        oauthProxy: "{{PROTOCOL}}://auth.{{DOMAIN}}/oauth2/sign_out",
        oauthProxyStart: "/oauth2/start",
        oauthProxyAuth: "/oauth2/auth",
        cognitoLogout: "{{OIDC_LOGOUT_URI}}",
        cognitoClientId: "{{OIDC_CLIENT_ID}}"
    };

    const cfg = window.FOSS_LOGOUT;

    // --------------------------------------------------------------
    // IdP-alive marker (localStorage)
    //
    // Tracks IdP SSO state client-side without cross-origin cookie
    // reads (which break on Safari ITP / Firefox ETP / any third-
    // party cookie restriction). Model:
    //
    //   • Apps soft-logout → clear oauth2-proxy cookie only; marker
    //     is left untouched (app code doesn't know this key exists).
    //   • Portal hard-logout → 3-layer chain + clearMarker(): both
    //     proxy and IdP are cleared, marker cleared too.
    //
    // TTL guards against stale markers left over when the IdP
    // itself ends the session (SSO TTL expiry, admin revoke).
    // False positives self-correct on the next click of Logout:
    // the IdP /logout is idempotent, the flow completes, the toast
    // fires, the marker is cleared.
    // --------------------------------------------------------------
    const MARKER_KEY = "foss_cognito_alive_ts";
    const MARKER_TTL_MS = 24 * 60 * 60 * 1000;

    function setMarker() {
        try { localStorage.setItem(MARKER_KEY, String(Date.now())); } catch (e) {}
    }
    function clearMarker() {
        try { localStorage.removeItem(MARKER_KEY); } catch (e) {}
    }
    function markerFresh() {
        try {
            const raw = localStorage.getItem(MARKER_KEY);
            if (!raw) return false;
            const ts = parseInt(raw, 10);
            if (!Number.isFinite(ts)) return false;
            return (Date.now() - ts) < MARKER_TTL_MS;
        } catch (e) {
            return false;
        }
    }

    async function checkProxySession() {
        try {
            const res = await fetch(cfg.oauthProxyAuth, {
                method: "GET",
                credentials: "include",
                cache: "no-store",
                redirect: "manual"
            });
            return res.ok || res.status === 202;
        } catch (e) {
            return false;
        }
    }

    async function detectAuthState() {
        if (await checkProxySession()) {
            setMarker();
            return true;
        }
        return markerFresh();
    }

    function setButtonState(loggedIn) {
        const btn = document.getElementById("auth-btn");
        if (!btn) return;
        btn.disabled = false;
        btn.classList.remove("auth-btn-login", "auth-btn-logout");
        if (loggedIn) {
            btn.textContent = "Log out of all apps";
            btn.classList.add("auth-btn-logout");
            btn.onclick = logoutAll;
        } else {
            btn.textContent = "Login";
            btn.classList.add("auth-btn-login");
            btn.onclick = loginAll;
        }
    }

    function loginAll() {
        const btn = document.getElementById("auth-btn");
        if (btn) { btn.disabled = true; btn.textContent = "Redirecting..."; }
        sessionStorage.setItem("foss_just_logged_in", "1");
        window.location.href = cfg.oauthProxyStart + "?rd=" + encodeURIComponent(cfg.portal);
    }

    function logoutAll() {
        const btn = document.getElementById("auth-btn");
        if (btn) { btn.disabled = true; btn.textContent = "Logging out..."; }
        sessionStorage.setItem("foss_just_logged_out", "1");
        // Clear eagerly — if the 3-layer chain aborts mid-flight
        // the portal correctly shows "Login" on return instead of
        // claiming the IdP is still alive.
        clearMarker();

        let rd;
        if (cfg.cognitoLogout && cfg.cognitoClientId) {
            // 3-layer: oauth2-proxy clears cookie → IdP /logout
            // clears SSO → portal. `rd=` single-encoded so oauth2-
            // proxy decodes once and the IdP receives clean
            // `?client_id=…&logout_uri=…`.
            const cognito = cfg.cognitoLogout
                + "?client_id=" + cfg.cognitoClientId
                + "&logout_uri=" + encodeURIComponent(cfg.portal);
            rd = cognito
                .replace(/\?/g, "%3F")
                .replace(/&/g, "%26")
                .replace(/=/g, "%3D");
        } else {
            // 2-layer fallback — oauth2-proxy only, IdP SSO survives.
            rd = encodeURIComponent(cfg.portal);
        }
        window.location.href = cfg.oauthProxy + "?rd=" + rd;
    }

    function showToast(message, variant) {
        const toast = document.createElement("div");
        toast.className = "toast";
        if (variant === "info") toast.style.borderLeftColor = "#16a34a";
        toast.textContent = message;
        document.body.appendChild(toast);
        void toast.offsetHeight;
        toast.classList.add("toast-visible");
        setTimeout(() => {
            toast.classList.remove("toast-visible");
            setTimeout(() => toast.remove(), 300);
        }, 4000);
    }

    function consumeAuthFlags(loggedIn) {
        if (sessionStorage.getItem("foss_just_logged_out") === "1") {
            sessionStorage.removeItem("foss_just_logged_out");
            showToast("You have been logged out.", "logout");
            return;
        }
        if (loggedIn && sessionStorage.getItem("foss_just_logged_in") === "1") {
            sessionStorage.removeItem("foss_just_logged_in");
            showToast("You are now logged in.", "info");
        }
    }

    document.addEventListener("DOMContentLoaded", async () => {
        const loggedIn = await detectAuthState();
        setButtonState(loggedIn);
        consumeAuthFlags(loggedIn);
    });

    // When the browser restores the page from bfcache (back button), DOMContentLoaded
    // does not fire — re-evaluate auth state so the button never stays stuck on "Redirecting…".
    window.addEventListener("pageshow", async (event) => {
        if (event.persisted) {
            const loggedIn = await detectAuthState();
            setButtonState(loggedIn);
        }
    });
})();
</script>

</body>
</html>
